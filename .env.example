# AI プロバイダー（任意）
# gemini | openai | free
# 未指定時: GEMINI_API_KEY → OPENAI_API_KEY → 無料モード の順で自動選択
AI_PROVIDER=gemini

# Google Gemini（無料枠あり・推奨）
# https://aistudio.google.com/apikey で発行（「AIza」または「AQ.」で始まる）
GEMINI_API_KEY=

# OpenAI（任意。ベクトル検索 embedding にも使用）
# https://platform.openai.com/api-keys で発行。sk- で始まる
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
